{
  "name": "placesiwent-checks",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "lint": "eslint tests scripts *.cjs assets/monitoring.js",
    "check:syntax": "node scripts/check-syntax.cjs",
    "format:check": "prettier --check tests scripts *.cjs .prettierrc.json .github/workflows/playwright.yml .github/dependabot.yml",
    "format": "prettier --write tests scripts *.cjs .prettierrc.json .github/workflows/playwright.yml .github/dependabot.yml",
    "check": "npm run lint && npm run check:syntax && npm run format:check && npm run test:weather",
    "build": "node scripts/build-static.cjs",
    "test:performance": "node scripts/check-performance.cjs",
    "test:visual:update": "playwright test --grep @visual --project chromium --update-snapshots",
    "test:weather": "node --test tests/weather-data.unit.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "acorn": "8.19.0",
    "chrome-launcher": "1.2.3",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "leaflet": "1.9.4",
    "lighthouse": "13.6.0",
    "prettier": "3.10.0"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "11.0.8"
    },
    "eslint": {
      "minimatch": "11.0.8"
    }
  }
}
